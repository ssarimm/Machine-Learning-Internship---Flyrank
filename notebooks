      "source": [
        "\n",
        "import os, sys, subprocess\n",
        "\n",
        "IN_COLAB = \"google.colab\" in sys.modules\n",
        "REPO_URL = \"https://github.com/flyrank-bih/flyrank-ml-internship-starter\"\n",
        "REPO_DIR = \"flyrank-ml-internship-starter\"\n",
        "\n",
        "if IN_COLAB:\n",
        "    if not os.path.isdir(REPO_DIR):\n",
        "        subprocess.run([\"git\", \"clone\", \"--depth\", \"1\", REPO_URL, REPO_DIR], check=True)\n",
        "    os.chdir(REPO_DIR)\n",
        "    subprocess.run([sys.executable, \"-m\", \"pip\", \"install\", \"-q\", \"-r\", \"requirements.txt\"], check=True)\n",
        "elif os.path.basename(os.getcwd()) == \"notebooks\":\n",
        "    os.chdir(\"..\")\n",
        "\n",
        "import pandas as pd, numpy as np\n",
        "df = pd.read_csv(\"data/raw/content_refresh_anonymized.csv\")\n",
        "\n",
        "# The label: a page is 'declining' when its recent trend is down. Simple, honest starter label.\n",
        "df[\"is_declining_label\"] = df[\"trend_direction\"].str.lower().eq(\"down\").astype(int)\n",
        "print(df.shape[0], \"pages |  declining rate:\", round(df[\"is_declining_label\"].mean(), 3))"
      ],
      "id": "M1wIjIMmGrL8"
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "# 1. What percentage of pages are labelled as declining?\n",
        "overall_decline_pct = (\n",
        "    (df[\"trend_direction\"] == \"down\").mean() * 100\n",
        ")\n",
        "\n",
        "# 2. Calculate CTR for pages with at least 100 impressions.\n",
        "visible = df[df[\"impressions_90d\"] >= 100].copy()\n",
        "\n",
        "visible[\"calculated_ctr_pct\"] = (\n",
        "    visible[\"clicks_90d\"] / visible[\"impressions_90d\"]\n",
        ") * 100\n",
        "\n",
        "# Find the average calculated CTR for each position tier.\n",
        "ctr_by_position = (\n",
        "    visible.groupby(\"position_tier\")[\"calculated_ctr_pct\"].mean()\n",
        ")\n",
        "\n",
        "# 3. Compare decline rates for stale + visible pages vs all pages.\n",
        "stale_visible = df[\n",
        "    (df[\"days_since_last_update\"] >= 180)\n",
        "    & (df[\"impressions_90d\"] >= 500)\n",
        "].copy()\n",
        "\n",
        "stale_decline_pct = (\n",
        "    (stale_visible[\"trend_direction\"] == \"down\").mean() * 100\n",
        ")\n",
        "\n",
        "print(f\"Total pages: {len(df):,}\")\n",
        "print(f\"Overall decline rate: {overall_decline_pct:.2f}%\")\n",
        "print(\"\\nAverage calculated CTR by position tier (%):\")\n",
        "print(ctr_by_position.round(2).to_string())\n",
        "print(f\"\\nStale + visible pages: {len(stale_visible):,}\")\n",
        "print(f\"Decline rate among stale + visible pages: {stale_decline_pct:.2f}%\")\n"
      ],
